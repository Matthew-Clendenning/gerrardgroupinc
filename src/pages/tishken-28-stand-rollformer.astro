---
import Layout from "../layouts/Layout.astro";
import Directory from "../components/MachineDirectory.astro";
import { Carousel } from "../components/Carousel.jsx";
import { slides13 } from "../data/carouselData.json";
import "../styles/product-detail.css";
---

<Layout
    title={'28-Stand Tishken Rollformer 8"/10" x 1.50" for Sale | Gerrard'}
    description={'Used 28-stand Tishken rollforming line: 12-stand (8" roll space) and 16-stand (10" roll space) sections, 1.50" shafts, 15 HP drive. Ref 11868-HK, in storage Toledo, OH. Contact for pricing.'}
    canon="https://gerrardgroupinc.com/tishken-28-stand-rollformer/"
    jsonLdType="product"
    jsonLdData={{
        name: '28-Stand Tishken Rollformer 8"/10" x 1.50"',
        description: 'Used 28-stand Tishken (Detroit) rollforming line consisting of a 12-stand Model 12-HMW-1 1/2 section with 8" roll space and a 16-stand Model 16-HMW-1 1/2 section with 10" roll space. 1.500" shaft diameter, 9" horizontal centers, 4" to 8" adjustment range, 15 HP 1150 RPM drive motor. Ref #11868-HK. Note: one top shaft missing on the 16-stand section. In storage in Toledo, OH.',
        brand: "Tishken",
        category: "Roll Forming Equipment",
        price: "0",
        sku: "11868-HK",
        condition: "UsedCondition",
        mpn: "12-HMW-1 1/2 / 16-HMW-1 1/2",
        image: "https://gerrardgroupinc.com/images/tishken-rollformer-1.webp",
        faq: [
            { question: "What is a Tishken rollformer used for?", answer: "A rollformer progressively shapes coil or sheet metal into a finished profile by passing it through a series of consecutive roll stands. This 28-stand Tishken line is suited to producing studs, track, channels, angles, trim, and other long metal profiles in high volume. Tishken (Detroit) is a long-established builder of heavy-duty rollforming equipment." },
            { question: "What are the specifications of this 28-stand Tishken line?", answer: "The line has two sections. Section #1 (Model 12-HMW-1 1/2) has 12 stands with 8.00\" roll space; Section #2 (Model 16-HMW-1 1/2) has 16 stands with 10.00\" roll space. Both use 1.500\" diameter shafts on 9.00\" horizontal centers with 4.00\" vertical adjustment and a 4\" to 8\" adjustment range. Section #2 includes a 15 HP, 1150 RPM drive motor." },
            { question: "What condition is this rollformer in and where is it located?", answer: "This is a used Tishken rollformer (Ref #11868-HK) currently in storage in Toledo, OH. Please note that one top shaft is missing on the 16-stand section. It is available for inspection by appointment; contact Gerrard Group for details." },
            { question: "Does Gerrard Group offer shipping and installation?", answer: "Yes. Gerrard Group Inc provides full rigging, transportation, and installation services for heavy industrial equipment across the United States, Mexico, and Canada. Contact us at (847) 894-3434 for a quote." }
        ]
    }}
    ogType="product"
    ogImage="https://gerrardgroupinc.com/images/tishken-rollformer-1.webp"
    ogImageAlt="Used 28-Stand Tishken Rollformer for Sale - Gerrard Group"
    >
    <Directory
        title={'28-Stand Tishken Rollformer 8"/10" x 1.50"'}
        page="Roll Formers"
        page2="Machine Details"
        href="/liquidations"
    />
    <main class="pd-page">
        <div class="pd-content">
            <div class="pd-layout">
                <Carousel client:load data={slides13} />
                <article class="pd-info">
                    <h2 class="pd-info__title">28-Stand Tishken Rollformer — 8"/10" x 1.50"</h2>
                    <p class="pd-info__model">Ref #: <strong>11868-HK</strong> — Tishken, Detroit</p>
                    <hr class="pd-info__divider">
                    <div class="pd-specs">
                        <p class="pd-specs__group-title">Overview</p>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Manufacturer</span>
                            <span class="pd-spec__value">Tishken (Detroit)</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Total Stands</span>
                            <span class="pd-spec__value">28 (12 + 16)</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Shaft Diameter</span>
                            <span class="pd-spec__value">1.500"</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Roll Space</span>
                            <span class="pd-spec__value">8.00" (Sec. 1) / 10.00" (Sec. 2)</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Condition</span>
                            <span class="pd-spec__value">Used — one top shaft missing on 16-stand section</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Location</span>
                            <span class="pd-spec__value">In Storage — Toledo, OH</span>
                        </div>

                        <p class="pd-specs__group-title">Section #1 — Model 12-HMW-1 1/2</p>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Number of Stands</span>
                            <span class="pd-spec__value">12</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Shaft Diameter</span>
                            <span class="pd-spec__value">1.500"</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Roll Space</span>
                            <span class="pd-spec__value">8.00"</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Horizontal Centers</span>
                            <span class="pd-spec__value">9.00"</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Center of Bottom Spindle to Base</span>
                            <span class="pd-spec__value">4.500"</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Vertical Adjustment</span>
                            <span class="pd-spec__value">4.00"</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Adjustment Range</span>
                            <span class="pd-spec__value">4" to 8"</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Overall Size</span>
                            <span class="pd-spec__value">142" L x 48" W x 47" H</span>
                        </div>

                        <p class="pd-specs__group-title">Section #2 — Model 16-HMW-1 1/2</p>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Number of Stands</span>
                            <span class="pd-spec__value">16</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Shaft Diameter</span>
                            <span class="pd-spec__value">1.500"</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Roll Space</span>
                            <span class="pd-spec__value">10.00"</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Horizontal Centers</span>
                            <span class="pd-spec__value">9.00"</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Center of Bottom Spindle to Base</span>
                            <span class="pd-spec__value">4.50"</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Vertical Adjustment</span>
                            <span class="pd-spec__value">4.00"</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Adjustment Range</span>
                            <span class="pd-spec__value">4" to 8"</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Drive Motor</span>
                            <span class="pd-spec__value">15 HP, 1150 RPM</span>
                        </div>
                        <div class="pd-spec">
                            <span class="pd-spec__label">Overall Size</span>
                            <span class="pd-spec__value">178" L x 48" W x 47" H</span>
                        </div>
                    </div>
                    <div class="pd-pricing">
                        <p class="pd-pricing__contact">Contact for Pricing</p>
                    </div>
                    <div class="pd-actions">
                        <a href="/contact/" class="pd-btn pd-btn--primary">Request a Quote</a>
                        <a href="tel:+18478943434" class="pd-btn pd-btn--secondary">Call (847) 894-3434</a>
                    </div>
                </article>
            </div>
            <section class="pd-faq">
                <h3 class="pd-faq__title">Frequently Asked Questions</h3>
                <div class="pd-faq__item">
                    <p class="pd-faq__question">What is a Tishken rollformer used for?</p>
                    <p class="pd-faq__answer">A rollformer progressively shapes coil or sheet metal into a finished profile by passing it through a series of consecutive roll stands. This 28-stand Tishken line is suited to producing studs, track, channels, angles, trim, and other long metal profiles in high volume. Tishken (Detroit) is a long-established builder of heavy-duty rollforming equipment.</p>
                </div>
                <div class="pd-faq__item">
                    <p class="pd-faq__question">What are the specifications of this 28-stand Tishken line?</p>
                    <p class="pd-faq__answer">The line has two sections. Section #1 (Model 12-HMW-1 1/2) has 12 stands with 8.00" roll space; Section #2 (Model 16-HMW-1 1/2) has 16 stands with 10.00" roll space. Both use 1.500" diameter shafts on 9.00" horizontal centers with 4.00" vertical adjustment and a 4" to 8" adjustment range. Section #2 includes a 15 HP, 1150 RPM drive motor.</p>
                </div>
                <div class="pd-faq__item">
                    <p class="pd-faq__question">What condition is this rollformer in and where is it located?</p>
                    <p class="pd-faq__answer">This is a used Tishken rollformer (Ref #11868-HK) currently in storage in Toledo, OH. Please note that one top shaft is missing on the 16-stand section. It is available for inspection by appointment; contact Gerrard Group for details.</p>
                </div>
                <div class="pd-faq__item">
                    <p class="pd-faq__question">Does Gerrard Group offer shipping and installation?</p>
                    <p class="pd-faq__answer">Yes. Gerrard Group Inc provides full rigging, transportation, and installation services for heavy industrial equipment across the United States, Mexico, and Canada. Contact us at (847) 894-3434 for a quote.</p>
                </div>
            </section>
            <section class="pd-related">
                <h3 class="pd-related__title">Related Equipment</h3>
                <div class="pd-related__list">
                    <a href="/peddinghaus-peddibot-1200/" class="pd-related__link">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Peddinghaus PeddiBot-1200 Robotic CNC Cutting Machine
                    </a>
                    <a href="/gernetti-band-saw-38-18/" class="pd-related__link">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Peddinghaus / Gernetti SHN 38-18 Band Saw
                    </a>
                </div>
            </section>
            <a href="/liquidations/" class="pd-back">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M10 13l-5-5 5-5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Back to All Equipment
            </a>
        </div>
    </main>
</Layout>
